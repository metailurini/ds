# ds language syntax catalog
#
# This file is the project-wide syntax inventory for ds.
# It is intentionally a catalog, not a runnable script.
#
# Purpose:
# - keep the whole language shape visible in one place;
# - prevent syntax drift across milestone specs;
# - make it clear which syntax is planned, supported, deferred, or rejected;
# - give parser, formatter, documentation, and test fixtures a shared reference.
#
# Status markers:
# - [v0.x.0] means the syntax is planned for that version.
# - [stable] means the syntax is expected to survive into 1.0.0.
# - [candidate] means the syntax is likely but still open to change.
# - [deferred] means the idea is intentionally not in the current roadmap.
# - [rejected] means do not add this syntax unless the product principles change.
#
# Rule:
# Every real ds syntax must eventually define:
# - parser behavior;
# - semantic behavior;
# - VM behavior;
# - standalone Bash emission behavior;
# - tests;
# - documentation.

# -----------------------------------------------------------------------------
# 1. Comments [v0.1.0] [stable]
# -----------------------------------------------------------------------------

# A line comment starts with # and continues to the end of the line.


# -----------------------------------------------------------------------------
# 2. Variables [v0.1.0] [stable]
# -----------------------------------------------------------------------------

let name = "Danh"
let count = 3
let ok = true
let missing = null

# Type annotations are optional for normal variables.
let retry: int = 3
let target: string = "staging"
let force: bool = false

# Reassignment is allowed when the variable already exists.
count = count + 1
count += 1
count -= 1

# Environment variables use an explicit env namespace. Direct assignment syntax
# is planned but deferred in v0.11.0; use `env.get` / `env.set` below today.
# env.NODE_ENV = "production"
# env.PATH += "./node_modules/.bin"


# -----------------------------------------------------------------------------
# 3. Literals [v0.1.0+] [stable]
# -----------------------------------------------------------------------------

let s = "hello"
let n = 123
let yes = true
let no = false
let none = null

# Raw strings are planned for regex-heavy and shell-heavy text.
let pattern_text = raw"\d+\s+\w+"


# -----------------------------------------------------------------------------
# 4. String interpolation [v0.2.0] [stable]
# -----------------------------------------------------------------------------

let app = "api"
echo "Deploying {app}"
echo "Deploying {app} to {target}"

# In normal strings, {name} and {name.field} interpolate variables and command-result fields.
# v0.19.0 also supports small portable specifiers such as {app:upper},
# {app:<10}, and {port:05d}. In command mode, $name passes a variable as a
# command argument.


# -----------------------------------------------------------------------------
# 5. Expressions [v0.1.0+] [stable]
# -----------------------------------------------------------------------------

let a = 1 + 2 * 3
let b = (1 + 2) * 3
let same = name == "Danh"
let different = name != "Danh"
let bigger = count > 3
let smaller = count < 10
let enough = count >= 3
let below = count <= 10
let not_ok = !ok
let both = ok && force
let either = ok || force

# Arithmetic operators *, /, %, ** and compound assignment *=, /=, %= are part
# of the v0.21.0 implementation surface.
let product = count * 2
let quotient = count / 2
let remainder = count % 3
let power = 2 ** 8

# Membership operator is implemented in v0.23.0 for scalar arrays.
let known = app in ["api", "web", "worker"]

# Regex match is implemented in v0.23.0 for conservative regex literals.
let has_error = "ERROR: failed" matches /error|failed/i


# -----------------------------------------------------------------------------
# 6. Command statements [v0.1.0] [stable]
# -----------------------------------------------------------------------------

git status
npm install
docker compose up

# Variables passed to commands use $.
git checkout $target
./deploy.sh $app $target

# Normal expressions do not use $.
let message = "target={target}"


# -----------------------------------------------------------------------------
# 7. If / else [v0.1.0] [stable]
# -----------------------------------------------------------------------------

if target == "production" {
  npm test
}

if force {
  echo "force enabled"
} else {
  echo "normal mode"
}

# Current v0.3.0 VM/Bash condition semantics are conservative and tested:
# booleans, integers, and strings may be used as conditions; comparisons are
# string-style until a future type-aware semantic model is added.

if file.exists("package.json") {
  npm install
} else {
  fail "package.json not found"
}


# -----------------------------------------------------------------------------
# 8. Blocks and scope [v0.1.0+] [candidate]
# -----------------------------------------------------------------------------

{
  let local_name = "inside block"
  echo "{local_name}"
}

# Variables declared inside a block should not leak outside the block unless the
# specific construct says otherwise.


# -----------------------------------------------------------------------------
# 9. Script arguments block [v0.5.0] [implemented]
# -----------------------------------------------------------------------------

script {
  arg app: string
  option target: string = "staging"
  option retries: int = 3
  flag force: bool = false
}

# Expected CLI:
# ds deploy.ds api --target production --retries 5 --force
#
# Expected generated help:
# deploy.ds <app> [options]
#   --target string    default: staging
#   --retries int      default: 3
#   --force            boolean flag

# End option parsing with --.
# ds deploy.ds api -- --not-an-option

# Integer args/options/defaults use the project's signed 64-bit integer range.
# Values outside that range are rejected by both VM execution and emitted Bash.


# -----------------------------------------------------------------------------
# 10. Imports / includes [v0.6.0] [implemented]
# -----------------------------------------------------------------------------

import "./lib.ds"

# Named imports are deferred until simple imports are proven.
from "./deploy.ds" import deploy, rollback

# Rules:
# - imports are resolved relative to the importing file;
# - each imported file is loaded once;
# - import cycles are errors;
# - emitted Bash bundles imported ds files into one standalone script;
# - imported files cannot declare their own script blocks in v0.6.0;
# - tokens/ast debug commands remain root-file views.


# -----------------------------------------------------------------------------
# 11. Command result capture [v0.7.0] [stable]
# -----------------------------------------------------------------------------

let result = run npm test

if result.failed {
  echo result.stderr
  exit result.status
}

# `code` is kept as a compatibility alias for `status`.
echo result.code

if result.ok {
  echo result.stdout
}

let branch = run git branch --show-current

if branch.failed {
  fail "not a git repository"
}

echo "Current branch: {branch.stdout}"

# v0.19.0 adds scoped string methods such as `.trim()` and `.split()` with
# matching VM and standalone Bash behavior.


# -----------------------------------------------------------------------------
# 12. Redirection [v0.7.0] [stable]
# -----------------------------------------------------------------------------

npm run build |> "build.out"
npm run build |>> "build.out"
npm run build !> "build.err"
npm run build !>> "build.err"
npm run build &> "build.log"
npm run build &>> "build.log"

# Meaning:
# |>   stdout overwrite
# |>>  stdout append
# !>   stderr overwrite
# !>>  stderr append
# &>   stdout and stderr overwrite
# &>>  stdout and stderr append


# -----------------------------------------------------------------------------
# 13. Pipes [v0.18.0] [implemented]
# -----------------------------------------------------------------------------

cat access.log | grep "ERROR" | sort | uniq

let errors = run cat access.log | grep "ERROR"

# Plain command pipelines are fail-fast. Captured `run` pipelines produce the
# normal command-result fields and use pipefail-style status semantics.
# Redirection suffixes apply to the whole plain pipeline.


# -----------------------------------------------------------------------------
# 14. Functions [v0.9.0] [stable]
# -----------------------------------------------------------------------------

fn deploy(target) {
  echo "Deploying {target}"
  ./deploy.sh $target
}

deploy("production")

fn deploy_default(target = "staging") {
  echo "Deploying {target}"
}

# Typed parameters remain planned syntax. v0.9.0 deliberately rejects typed
# function parameters until call-boundary validation exists in both the VM and
# emitted standalone Bash.
#
# fn restart(service: string) {
#   docker compose restart $service
# }

# Scalar `return expr` values are part of the v0.25.0 implementation surface.
# v0.26.0 extends value returns to flat scalar arrays, flat scalar maps/objects,
# and command-result objects.
# Value-returning functions may call other value-returning functions declared
# later in the same composed program when the return kind is statically known.
# Functions called as expression values reject plain command statements so VM
# execution and emitted Bash cannot confuse user stdout with the private typed
# scalar return payload. Statement-style calls may still stream stdout and ignore
# the scalar return. Use captured `run` expressions inside value functions when
# command output should participate in a returned value. Nested collections,
# collection-valued parameters, map iteration, index assignment, and direct
# function-call interpolation in command words remain deferred.

fn to_upper(s = "hello") {
  return s.upper()
}

let label = to_upper("hello")

fn apps() {
  return ["api", "web"]
}

let names = apps()
let first_app = names[0]

fn service() {
  return { name: "api", port: 8080, enabled: true }
}

let app_info = service()
let app_name = app_info.name

fn probe() {
  return run printf "ok"
}

let probe_result = probe()
let probe_output = probe_result.stdout

# Permanent non-goals for functions:
# - no closures;
# - no anonymous functions;
# - no higher-order functions;
# - no complex generics.


# -----------------------------------------------------------------------------
# 15. Arrays [v0.10.0] [stable]
# -----------------------------------------------------------------------------

let services = ["api", "web", "worker"]
let first_service = services[0]
services.push("cron")

for service in services {
  docker compose restart $service
}


# -----------------------------------------------------------------------------
# 16. Maps / objects [v0.10.0] [partially implemented]
# -----------------------------------------------------------------------------

let ports = {
  api: 3000,
  web: 5173,
  worker: 9000
}

let api_port = ports.api
let web_port = ports["web"]

# Map iteration is deferred in the initial v0.10.0 implementation; use direct
# field or bracket access instead.
#
# for name, port in ports {
#   echo "{name} runs on {port}"
# }

# Empty map literals, empty map keys, nested maps, nested arrays, computed
# non-string keys, and element/value expressions that cannot yet be assigned
# inside emitted Bash collections are deferred. Bind complex scalar expressions
# first. Bash emission uses Bash associative arrays for maps and emits a Bash 4+
# guard only for scripts that use maps. Missing keys fail with an explicit
# runtime error in emitted Bash.


# -----------------------------------------------------------------------------
# 17. Loops and case [v0.10.0 / v0.17.0] [implemented]
# -----------------------------------------------------------------------------

# `for item in array` is implemented in v0.10.0.
# `while`, `break`, `continue`, scalar reassignment, and expression-style
# `case` are implemented in v0.17.0.
# `until` is rejected — use `while !condition` instead.

for service in services {
  echo "{service}"
}

# while — v0.17.0

let i = 0
while i < 3 {
  echo "i={i}"
  i += 1
}

# break / continue — v0.17.0

for item in services {
  if item == "skip" { continue }
  if item == "stop" { break }
  echo $item
}

# case — v0.17.0. Selectors are normal expressions, not command `$name` words.

case target {
  "bash" | "sh" { echo "shell" }
  "python"      { echo "python" }
  _             { echo "other" }
}

# String binary `+` remains deferred for Bash parity; use interpolation.

# Integer range loop sources are implemented in v0.23.0; `lines` is implemented in v0.11.0.
for n in 1..10 {
  echo "{n}"
}


# -----------------------------------------------------------------------------
# 18. Standard library: file / dir / path [v0.11.0] [stable]
# -----------------------------------------------------------------------------

if file.exists("package.json") {
  echo "package exists"
}

if file.is_file("README.md") {
  echo "README is a file"
}

if dir.exists("src") {
  echo "src exists"
}

let text = file.read("README.md")
file.write("out.txt", text)
file.append("out.txt", "\n")

# Text file helpers reject embedded NUL bytes in v0.11.0. Use future binary
# helpers once they are designed instead.

let cwd = path.cwd()
let joined = path.join("src", "main.ds")
let base = path.basename(joined)
let parent = path.dirname(joined)
let ext = path.ext(joined)


# -----------------------------------------------------------------------------
# 19. Standard library: command helpers [v0.11.0] [stable]
# -----------------------------------------------------------------------------

if cmd.exists("git") {
  echo "git found"
}

# Direct or PATH-based command checks only count executable files, not
# directories with execute/search permission.

cmd.require("git")
cmd.require("npm")


# -----------------------------------------------------------------------------
# 20. Standard library: environment [v0.11.0] [stable]
# -----------------------------------------------------------------------------

let target = env.get("TARGET", "staging")
env.set("NODE_ENV", "production")
env.unset("DEBUG")

# Direct `env.NAME` assignment remains deferred in v0.11.0.
# env.NODE_ENV = "production"
# env.PATH += "./node_modules/.bin"


# -----------------------------------------------------------------------------
# 21. Globbing and line iteration [v0.11.0] [stable]
# -----------------------------------------------------------------------------

for file in glob("*.txt") {
  echo $file
}

# Recursive `**` globbing is rejected until VM/Bash parity is defined.
# for file in glob("src/**/*.c") {
#   echo $file
# }

# glob! means the pattern must match at least one file.
for file in glob!("*.ds") {
  echo $file
}

for line in lines("input.txt") {
  echo $line
}


# -----------------------------------------------------------------------------
# 22. Failure, exit, and strict mode [v0.3.0+] [stable]
# -----------------------------------------------------------------------------

strict

fail "something went wrong"
exit 1

# By default, direct command statements fail the script if the command exits
# non-zero. Captured `run` commands do not auto-fail because the result is being
# handled explicitly.


# -----------------------------------------------------------------------------
# 23. Defer / cleanup [v0.22.0] [implemented]
# -----------------------------------------------------------------------------

let tmp = temp.dir()

defer {
  remove tmp, recursive: true
}

echo "working in {tmp}"

# Plain `defer` is EXIT cleanup and runs in LIFO order. Signal-specific
# cleanup is available for the portable EXIT/INT/TERM subset.

defer on: "EXIT" {
  echo "leaving"
}

defer on: "INT" {
  echo "interrupted, cleaning up"
  exit 130
}

defer on: "TERM" {
  echo "terminated"
  exit 143
}

# Handler registration is process-scope. Handlers may use globals, script
# arguments, imports, and function calls, but function-local captures and direct
# `return` from handlers are rejected. Handler context values such as a
# `$LINENO`-equivalent are not available yet; they remain deferred until VM and
# emitted Bash can share one portable source-location model.


# -----------------------------------------------------------------------------
# 23. Safer deletion [deferred] [candidate]
# -----------------------------------------------------------------------------

trash "old-output"
remove "build", recursive: true
delete_forever "dangerous-path"

# This area should remain conservative and explicit.


# -----------------------------------------------------------------------------
# 24. Regex, ranges, and membership [v0.23.0] [implemented]
# -----------------------------------------------------------------------------

# v0.23.0 implements a conservative regex/membership/range surface with VM/Bash
# parity. Regex literals are scoped to `matches`, ranges are scoped to `for`
# loop sources, and membership is scoped to scalar arrays.

if "deploy failed" matches /failed/ {
  echo "bad"
}

let is_release = "release/123" matches /^release\/[0-9]+$/
let is_api = "API" matches /api/i

for n in 1..10 {
  echo "{n}"
}

let allowed = ["api", "web", "worker"]
let known_app = app in allowed

if (app in allowed) && ("release/123" matches /^release\//) {
  echo "deployable"
}

if "web" in "api,web,worker".split(",") {
  echo "known from split"
}

# Capture values, regex replacement/splitting, runtime regex strings, range
# values, reverse/stepped/half-open ranges, and membership over maps or unknown
# iterables remain deferred.
#
# let match = regex.match("v1.2.3", /v([0-9]+)\.([0-9]+)\.([0-9]+)/)
# let xs = 1..3

# Regex must be carefully specified because VM regex and Bash regex can differ.
# ds should restrict supported regex syntax if needed to preserve parity.


# -----------------------------------------------------------------------------
# 25. Tests [v0.14.0] [implemented]
# -----------------------------------------------------------------------------

test "string interpolation" {
  let name = "Danh"
  assert "Hello {name}" == "Hello Danh"
}

test "array indexing" {
  let xs = ["a", "b"]
  assert xs[1] == "b"
}

test "explicit failure helpers" {
  if false {
    fail "unreachable branch"
  }
  exit 0
}


# -----------------------------------------------------------------------------
# 26. Formatter and checker expectations [v0.15.0] [implemented]
# -----------------------------------------------------------------------------

# Formatter style:
# - two-space indentation;
# - opening brace on the same line;
# - one blank line between top-level declarations;
# - spaces around binary operators;
# - no trailing whitespace.
#
# The first formatter rejects files containing comments because the current
# lexer/parser pipeline does not retain trivia safely enough to preserve them.
# Comment-preserving formatting is deferred rather than silently dropping user
# comments.
#
# Formatter/checker CLI behavior:
# - `ds fmt file.ds` prints formatted source to stdout;
# - `ds fmt --check file.ds` reports whether the file is already formatted;
# - `ds fmt --write file.ds` and `ds fmt -w file.ds` update the file in place;
# - `ds check file.ds` keeps warnings non-fatal by default;
# - `ds check --warnings-as-errors file.ds` exits non-zero when warnings exist;
# - `ds check --no-warnings file.ds` suppresses the warning layer.


# -----------------------------------------------------------------------------
# 27. String methods [v0.19.0] [implemented]
# -----------------------------------------------------------------------------

# String methods extend the standard string value type. All methods have both
# VM behavior and Bash emission behavior.

let s = "  Hello, World!  "

let trimmed = s.trim()
let upper   = s.upper()
let lower   = s.lower()
let replaced = s.replace("World", "ds")
let has_world = s.contains("World")
let parts = s.split(", ")
let starts = s.starts_with("  Hello")
let ends   = s.ends_with("!  ")


# -----------------------------------------------------------------------------
# 28. String interpolation format specifiers [v0.19.0] [implemented]
# -----------------------------------------------------------------------------

# Format specifiers live inside {} so echo stays the single output primitive.
# No printf command is added to ds.

let port = 5432
let label = "api"

echo "{port:05d}"           # zero-padded integer
echo "{label:<10}"          # left-aligned, width 10
echo "{port:.2f}"           # fixed decimal rendering for integer values
echo "{label:upper}"        # named transform: uppercase
echo "{label:lower}"        # named transform: lowercase
echo "{label:trim}"         # named transform: trim

let body = """
line one
line two
"""
echo "{body}"

# Only specifiers with reliable VM/Bash emission parity are supported; general floats remain deferred.
# Full printf format strings are not a goal.


# -----------------------------------------------------------------------------
# 29. Signal traps [v0.22.0] [implemented]
# -----------------------------------------------------------------------------

# `trap` is a lower-level replacement-style handler for the same supported
# signal set. On dispatch, the matching trap runs first, then matching defers in
# LIFO order, then EXIT cleanup.

trap "INT" {
  echo "caught interrupt"
  exit 130
}

trap "TERM" {
  echo "caught termination"
  exit 143
}

trap "EXIT" {
  echo "low-level exit handler"
}

# `defer` handlers are stackable and run in last-in, first-out order. Repeated
# `trap` handlers replace the previous trap for the same signal. Supported
# signal literals are exactly "EXIT", "INT", and "TERM" in v0.22.0.
# Process-level handlers may be registered from functions only when the handler
# does not capture function-local variables. Direct `return` from a cleanup
# handler is rejected; use `exit` for process-level cleanup status instead.


# -----------------------------------------------------------------------------
# 30. Rejected or not-now syntax [rejected]
# -----------------------------------------------------------------------------

# Do not add classes before 1.0.0.
# class Service {}

# Do not add async/await before 1.0.0.
# async fn deploy() {}
# await deploy()

# Do not add macro systems before the core language is stable.
# macro something {}

# Do not copy Bash's confusing test syntax.
# if [ "$x" = "y" ]; then
# fi

# Do not copy Bash's fd redirection syntax into ds source.
# cmd > out.txt 2>&1
