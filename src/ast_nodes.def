/* AST structural schema: node kind, payload layout, and owned cleanup fields. */

LAYOUT(expr, text, "DsStr text;")
LAYOUT(expr, boolean, "bool boolean;")
LAYOUT(expr, regex, "DsStr regex;")
LAYOUT(expr, run, "DsCommand run;")
LAYOUT(expr, field, "struct { DsExpr *object; DsStr field; } field;")
LAYOUT(expr, unary, "struct { DsUnaryOp op; DsExpr *right; } unary;")
LAYOUT(expr, binary, "struct { DsExpr *left; DsBinaryOp op; DsExpr *right; } binary;")
LAYOUT(expr, call, "struct { DsStr name; DsExprVec args; } call;")
LAYOUT(expr, array, "struct { DsExprVec elements; } array;")
LAYOUT(expr, map, "struct { DsMapEntryVec entries; } map;")
LAYOUT(expr, index, "struct { DsExpr *object; DsExpr *index; } index;")
LAYOUT(expr, range, "struct { DsExpr *start; DsExpr *end; } range;")
NODE(expr, IDENT, text, "str:as.text")
NODE(expr, STRING, text, "str:as.text")
NODE(expr, INT, text, "str:as.text")
NODE(expr, BOOL, boolean, "")
NODE(expr, REGEX, regex, "str:as.regex")
NODE(expr, RUN, run, "command:as.run")
NODE(expr, FIELD, field, "ast_expr:as.field.object,str:as.field.field")
NODE(expr, UNARY, unary, "ast_expr:as.unary.right")
NODE(expr, BINARY, binary, "ast_expr:as.binary.left,ast_expr:as.binary.right")
NODE(expr, CALL, call, "str:as.call.name,ast_expr_vec:as.call.args")
NODE(expr, ARRAY, array, "ast_expr_vec:as.array.elements")
NODE(expr, MAP, map, "ast_map_vec:as.map.entries")
NODE(expr, INDEX, index, "ast_expr:as.index.object,ast_expr:as.index.index")
NODE(expr, RANGE, range, "ast_expr:as.range.start,ast_expr:as.range.end")
NODE(expr, ERROR, NONE, "")

LAYOUT(stmt, let_stmt, "struct { DsStr name; DsExpr *value; } let_stmt;")
LAYOUT(stmt, assign_stmt, "struct { DsStr name; DsAssignOp op; DsExpr *value; } assign_stmt;")
LAYOUT(stmt, index_assign_stmt, "struct { DsExpr *target; DsAssignOp op; DsExpr *value; } index_assign_stmt;")
LAYOUT(stmt, if_stmt, "struct { DsExpr *condition; DsStmt *then_branch; DsStmt *else_branch; } if_stmt;")
LAYOUT(stmt, block_stmt, "struct { DsStmtVec statements; } block_stmt;")
LAYOUT(stmt, cmd_stmt, "DsCommand cmd_stmt;")
LAYOUT(stmt, import_stmt, "struct { DsStr path; } import_stmt;")
LAYOUT(stmt, fn_stmt, "struct { DsStr name; DsFnParamVec params; DsStmt *body; } fn_stmt;")
LAYOUT(stmt, call_stmt, "struct { DsStr name; DsExprVec args; } call_stmt;")
LAYOUT(stmt, for_stmt, "struct { DsStr key_name; DsStr value_name; bool has_value_name; DsExpr *iterable; DsStmt *body; } for_stmt;")
LAYOUT(stmt, while_stmt, "struct { DsExpr *condition; DsStmt *body; } while_stmt;")
LAYOUT(stmt, case_stmt, "struct { DsExpr *selector; DsCaseArmVec arms; } case_stmt;")
LAYOUT(stmt, push_stmt, "struct { DsStr name; DsExpr *value; } push_stmt;")
LAYOUT(stmt, test_stmt, "struct { DsStr name; DsStmt *body; } test_stmt;")
LAYOUT(stmt, assert_stmt, "struct { DsExpr *condition; } assert_stmt;")
LAYOUT(stmt, return_stmt, "struct { DsExpr *value; } return_stmt;")
LAYOUT(stmt, handler_stmt, "struct { DsHandlerSignal signal; DsStr signal_text; DsStmt *body; } handler_stmt;")
NODE(stmt, LET, let_stmt, "str:as.let_stmt.name,ast_expr:as.let_stmt.value")
NODE(stmt, ASSIGN, assign_stmt, "str:as.assign_stmt.name,ast_expr:as.assign_stmt.value")
NODE(stmt, INDEX_ASSIGN, index_assign_stmt, "ast_expr:as.index_assign_stmt.target,ast_expr:as.index_assign_stmt.value")
NODE(stmt, IF, if_stmt, "ast_expr:as.if_stmt.condition,ast_stmt:as.if_stmt.then_branch,ast_stmt:as.if_stmt.else_branch")
NODE(stmt, BLOCK, block_stmt, "ast_stmt_vec:as.block_stmt.statements")
NODE(stmt, CMD, cmd_stmt, "command:as.cmd_stmt")
NODE(stmt, IMPORT, import_stmt, "str:as.import_stmt.path")
NODE(stmt, FN, fn_stmt, "str:as.fn_stmt.name,ast_fn_param_vec:as.fn_stmt.params,ast_stmt:as.fn_stmt.body")
NODE(stmt, CALL, call_stmt, "str:as.call_stmt.name,ast_expr_vec:as.call_stmt.args")
NODE(stmt, FOR, for_stmt, "str:as.for_stmt.key_name,str:as.for_stmt.value_name,ast_expr:as.for_stmt.iterable,ast_stmt:as.for_stmt.body")
NODE(stmt, WHILE, while_stmt, "ast_expr:as.while_stmt.condition,ast_stmt:as.while_stmt.body")
NODE(stmt, BREAK, NONE, "")
NODE(stmt, CONTINUE, NONE, "")
NODE(stmt, CASE, case_stmt, "ast_expr:as.case_stmt.selector,ast_case_arm_vec:as.case_stmt.arms")
NODE(stmt, PUSH, push_stmt, "str:as.push_stmt.name,ast_expr:as.push_stmt.value")
NODE(stmt, TEST, test_stmt, "str:as.test_stmt.name,ast_stmt:as.test_stmt.body")
NODE(stmt, ASSERT, assert_stmt, "ast_expr:as.assert_stmt.condition")
NODE(stmt, RETURN, return_stmt, "ast_expr:as.return_stmt.value")
NODE(stmt, DEFER, handler_stmt, "str:as.handler_stmt.signal_text,ast_stmt:as.handler_stmt.body")
NODE(stmt, TRAP, handler_stmt, "str:as.handler_stmt.signal_text,ast_stmt:as.handler_stmt.body")
