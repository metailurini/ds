/* HIR structural schema: node kind, payload layout, and owned cleanup fields. */

LAYOUT(expr, text, "DsStr text;")
LAYOUT(expr, boolean, "bool boolean;")
LAYOUT(expr, regex, "DsStr regex;")
LAYOUT(expr, run, "DsLowerCommand run;")
LAYOUT(expr, field, "struct { DsLowerExpr *object; DsStr field; DsLowerValueKind field_kind; } field;")
LAYOUT(expr, unary, "struct { DsUnaryOp op; DsLowerExpr *right; } unary;")
LAYOUT(expr, binary, "struct { DsLowerExpr *left; DsBinaryOp op; DsLowerExpr *right; DsLowerValueKind left_kind; DsLowerValueKind right_kind; DsLowerValueKind right_element_kind; } binary;")
LAYOUT(expr, call, "struct { DsStr name; DsLowerExprVec args; DsLowerValueKind return_kind; bool is_user_function; bool returns_row; bool returns_row_array; DsLowerRowSchema row_schema; } call;")
LAYOUT(expr, interp, "struct { DsLowerExprVec parts; } interp;")
LAYOUT(expr, interp_format, "struct { DsLowerExpr *value; DsInterpFormatSpec spec; } interp_format;")
LAYOUT(expr, array, "struct { DsLowerExprVec elements; bool is_row_array; DsLowerRowSchema row_schema; } array;")
LAYOUT(expr, map, "struct { DsLowerMapEntryVec entries; bool is_row; DsLowerRowSchema row_schema; } map;")
LAYOUT(expr, index, "struct { DsLowerExpr *object; DsLowerExpr *index; bool object_is_array; bool object_is_map; bool map_key_literal; bool row_field_access; DsStr map_key; DsLowerValueKind element_kind; bool returns_row; DsLowerRowSchema row_schema; } index;")
LAYOUT(expr, range, "struct { DsLowerExpr *start; DsLowerExpr *end; } range;")
NODE(expr, IDENT, text, "str:as.text")
NODE(expr, STRING, text, "str:as.text")
NODE(expr, INT, text, "str:as.text")
NODE(expr, BOOL, boolean, "")
NODE(expr, REGEX, regex, "str:as.regex")
NODE(expr, RUN, run, "hir_command:as.run")
NODE(expr, FIELD, field, "hir_expr:as.field.object,str:as.field.field")
NODE(expr, UNARY, unary, "hir_expr:as.unary.right")
NODE(expr, BINARY, binary, "hir_expr:as.binary.left,hir_expr:as.binary.right")
NODE(expr, CALL, call, "str:as.call.name,hir_expr_vec:as.call.args,row_schema:as.call.row_schema")
NODE(expr, INTERP_TEXT, text, "str:as.text")
NODE(expr, INTERP_FORMAT, interp_format, "hir_expr:as.interp_format.value")
NODE(expr, INTERP, interp, "hir_expr_vec:as.interp.parts")
NODE(expr, ARRAY, array, "hir_expr_vec:as.array.elements,row_schema:as.array.row_schema")
NODE(expr, MAP, map, "hir_map_vec:as.map.entries,row_schema:as.map.row_schema")
NODE(expr, INDEX, index, "hir_expr:as.index.object,hir_expr:as.index.index,str:as.index.map_key,row_schema:as.index.row_schema")
NODE(expr, RANGE, range, "hir_expr:as.range.start,hir_expr:as.range.end")
NODE(expr, ERROR, NONE, "")

LAYOUT(stmt, let_stmt, "struct { DsStr name; DsLowerExpr *value; DsLowerValueKind value_kind; DsLowerValueKind element_kind; bool is_row; bool is_row_array; DsLowerRowSchema row_schema; } let_stmt;")
LAYOUT(stmt, assign_stmt, "struct { DsStr name; DsLowerAssignOp op; DsLowerExpr *value; } assign_stmt;")
LAYOUT(stmt, index_assign_stmt, "struct { DsStr name; DsLowerExpr *index; DsLowerExpr *value; bool target_is_array; bool target_is_map; DsLowerValueKind value_kind; } index_assign_stmt;")
LAYOUT(stmt, if_stmt, "struct { DsLowerExpr *condition; DsLowerStmt *then_branch; DsLowerStmt *else_branch; } if_stmt;")
LAYOUT(stmt, block_stmt, "struct { DsLowerStmtVec statements; bool scoped; } block_stmt;")
LAYOUT(stmt, call_stmt, "struct { DsStr name; DsLowerExprVec args; } call_stmt;")
LAYOUT(stmt, for_stmt, "struct { DsStr name; DsStr value_name; DsLowerExpr *iterable; DsLowerStmt *body; DsLowerValueKind element_kind; bool iterates_row_array; DsLowerRowSchema row_schema; } for_stmt;")
LAYOUT(stmt, while_stmt, "struct { DsLowerExpr *condition; DsLowerStmt *body; } while_stmt;")
LAYOUT(stmt, case_stmt, "struct { DsLowerExpr *selector; DsLowerCaseArmVec arms; } case_stmt;")
LAYOUT(stmt, push_stmt, "struct { DsStr name; DsLowerExpr *value; bool target_is_row_array; DsLowerRowSchema row_schema; } push_stmt;")
LAYOUT(stmt, assert_stmt, "struct { DsLowerExpr *condition; } assert_stmt;")
LAYOUT(stmt, return_stmt, "struct { DsLowerExpr *value; DsLowerValueKind return_kind; bool returns_row_array; DsLowerRowSchema row_schema; } return_stmt;")
LAYOUT(stmt, handler_stmt, "struct { DsHandlerSignal signal; DsLowerStmt *body; } handler_stmt;")
LAYOUT(stmt, cmd_stmt, "DsLowerCommand cmd_stmt;")
NODE(stmt, LET, let_stmt, "str:as.let_stmt.name,hir_expr:as.let_stmt.value,row_schema:as.let_stmt.row_schema")
NODE(stmt, ASSIGN, assign_stmt, "str:as.assign_stmt.name,hir_expr:as.assign_stmt.value")
NODE(stmt, INDEX_ASSIGN, index_assign_stmt, "str:as.index_assign_stmt.name,hir_expr:as.index_assign_stmt.index,hir_expr:as.index_assign_stmt.value")
NODE(stmt, IF, if_stmt, "hir_expr:as.if_stmt.condition,hir_stmt:as.if_stmt.then_branch,hir_stmt:as.if_stmt.else_branch")
NODE(stmt, BLOCK, block_stmt, "hir_stmt_vec:as.block_stmt.statements")
NODE(stmt, CMD, cmd_stmt, "hir_command:as.cmd_stmt")
NODE(stmt, CALL, call_stmt, "str:as.call_stmt.name,hir_expr_vec:as.call_stmt.args")
NODE(stmt, FOR_ARRAY, for_stmt, "str:as.for_stmt.name,str:as.for_stmt.value_name,hir_expr:as.for_stmt.iterable,hir_stmt:as.for_stmt.body,row_schema:as.for_stmt.row_schema")
NODE(stmt, FOR_MAP, for_stmt, "str:as.for_stmt.name,str:as.for_stmt.value_name,hir_expr:as.for_stmt.iterable,hir_stmt:as.for_stmt.body,row_schema:as.for_stmt.row_schema")
NODE(stmt, FOR_RANGE, for_stmt, "str:as.for_stmt.name,str:as.for_stmt.value_name,hir_expr:as.for_stmt.iterable,hir_stmt:as.for_stmt.body,row_schema:as.for_stmt.row_schema")
NODE(stmt, WHILE, while_stmt, "hir_expr:as.while_stmt.condition,hir_stmt:as.while_stmt.body")
NODE(stmt, BREAK, NONE, "")
NODE(stmt, CONTINUE, NONE, "")
NODE(stmt, CASE, case_stmt, "hir_expr:as.case_stmt.selector,hir_case_arm_vec:as.case_stmt.arms")
NODE(stmt, PUSH, push_stmt, "str:as.push_stmt.name,hir_expr:as.push_stmt.value,row_schema:as.push_stmt.row_schema")
NODE(stmt, ASSERT, assert_stmt, "hir_expr:as.assert_stmt.condition")
NODE(stmt, RETURN, return_stmt, "hir_expr:as.return_stmt.value,row_schema:as.return_stmt.row_schema")
NODE(stmt, DEFER, handler_stmt, "hir_stmt:as.handler_stmt.body")
NODE(stmt, TRAP, handler_stmt, "hir_stmt:as.handler_stmt.body")
