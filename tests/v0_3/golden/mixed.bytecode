constants:
  0: string "Danh"
  1: int 2
  2: bool true
  3: string "Hello "
  4: int 2
  5: string "count:"

instructions:
  0000 LOAD_CONST     r0, const 0    # tests/v0_3/fixtures/mixed.ds:1:12
  0001 STORE_VAR      name, r0    # tests/v0_3/fixtures/mixed.ds:1:1
