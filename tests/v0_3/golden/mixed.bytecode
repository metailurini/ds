  0020 LOAD_VAR       r12, count    # tests/v0_3/fixtures/mixed.ds:8:8
  0021 INTERP_JOIN    r10, join(r11, r12)    # tests/v0_3/fixtures/mixed.ds:8:8
  0022 RUN_CMD        ["echo", "\"count:{count}\""]    # tests/v0_3/fixtures/mixed.ds:8:3
  0023 POP_SCOPE         # tests/v0_3/fixtures/mixed.ds:7:15
  0024 RUN_CMD        ["echo", "\"done\""]    # tests/v0_3/fixtures/mixed.ds:10:1
  0025 RETURN         0    # tests/v0_3/fixtures/mixed.ds:1:1
