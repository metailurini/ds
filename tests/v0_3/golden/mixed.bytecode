  0009 LOAD_CONST     r5, const 3    # tests/v0_3/fixtures/mixed.ds:5:8
  0010 LOAD_VAR       r6, name    # tests/v0_3/fixtures/mixed.ds:5:8
  0011 INTERP_JOIN    r4, join(r5, r6)    # tests/v0_3/fixtures/mixed.ds:5:8
  0012 RUN_CMD        ["echo", "\"Hello {name}\""]    # tests/v0_3/fixtures/mixed.ds:5:3
  0013 POP_SCOPE         # tests/v0_3/fixtures/mixed.ds:4:7
  0014 LOAD_VAR       r7, count    # tests/v0_3/fixtures/mixed.ds:7:4
