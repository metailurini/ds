  0016 COMPARE        r9, r7 >= r8    # tests/v0_3/fixtures/mixed.ds:7:4
  0017 JUMP_IF_FALSE  r9, 24    # tests/v0_3/fixtures/mixed.ds:7:4
  0018 PUSH_SCOPE        # tests/v0_3/fixtures/mixed.ds:7:15
