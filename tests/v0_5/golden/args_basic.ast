Script
  ScriptBlock
    ArgDecl app: string
    OptionDecl target: string
      Default
        StringExpr "staging"
    OptionDecl retries: int
      Default
        IntExpr 3
    FlagDecl force: bool
      Default
        BoolExpr false
  CmdStmt
    Stage 0
      Word echo
      Word "Deploying {app} to {target}"
  CmdStmt
    Stage 0
      Word echo
      Word "retries={retries}"
  IfStmt
    Condition
      IdentExpr force
    Then
      BlockStmt
        CmdStmt
          Stage 0
            Word echo
            Word "force enabled"
    Else
      BlockStmt
        CmdStmt
          Stage 0
            Word echo
            Word "force disabled"
