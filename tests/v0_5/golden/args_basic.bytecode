args:
  arg app: string    # tests/v0_5/fixtures/args_basic.ds:2:3
  option target: string = "staging"    # tests/v0_5/fixtures/args_basic.ds:3:3
  option retries: int = 3    # tests/v0_5/fixtures/args_basic.ds:4:3
  flag force: bool = false    # tests/v0_5/fixtures/args_basic.ds:5:3

functions:
  <none>

constants:

instructions:
  0000 RUN_CMD        ["echo", "\"Deploying {app} to {target}\""]    # tests/v0_5/fixtures/args_basic.ds:8:1
  0001 RUN_CMD        ["echo", "\"retries={retries}\""]    # tests/v0_5/fixtures/args_basic.ds:9:1
  0002 LOAD_VAR       r0, force    # tests/v0_5/fixtures/args_basic.ds:11:4
  0003 JUMP_IF_FALSE  r0, 8    # tests/v0_5/fixtures/args_basic.ds:11:4
  0004 PUSH_SCOPE        # tests/v0_5/fixtures/args_basic.ds:11:10
  0005 RUN_CMD        ["echo", "\"force enabled\""]    # tests/v0_5/fixtures/args_basic.ds:12:3
  0006 POP_SCOPE         # tests/v0_5/fixtures/args_basic.ds:11:10
  0007 JUMP           11    # tests/v0_5/fixtures/args_basic.ds:11:1
  0008 PUSH_SCOPE        # tests/v0_5/fixtures/args_basic.ds:13:8
  0009 RUN_CMD        ["echo", "\"force disabled\""]    # tests/v0_5/fixtures/args_basic.ds:14:3
  0010 POP_SCOPE         # tests/v0_5/fixtures/args_basic.ds:13:8
  0011 RETURN         0    # tests/v0_5/fixtures/args_basic.ds:1:1
