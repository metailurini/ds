Script
  ImportStmt "./lib.ds"
  ImportStmt "./constants.ds"
  CmdStmt
    Stage 0
      Word echo
      Word "Deploying {app} to {target}"
  CmdStmt
    Stage 0
      Word echo
      Word $retries
  IfStmt
    Condition
      IdentExpr enabled
    Then
      BlockStmt
        CmdStmt
          Stage 0
            Word echo
            Word "enabled"
