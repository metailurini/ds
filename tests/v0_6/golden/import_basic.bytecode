args:
  <none>

constants:
  0: string "api"
  1: string "production"
  2: int 3
  3: bool true

instructions:
  0000 INTERPOLATE    r0, const 0    # tests/v0_6/fixtures/imports_basic/lib.ds:1:11
  0001 STORE_VAR      app, r0    # tests/v0_6/fixtures/imports_basic/lib.ds:1:1
  0002 INTERPOLATE    r1, const 1    # tests/v0_6/fixtures/imports_basic/constants.ds:1:14
  0003 STORE_VAR      target, r1    # tests/v0_6/fixtures/imports_basic/constants.ds:1:1
  0004 LOAD_CONST     r2, const 2    # tests/v0_6/fixtures/imports_basic/constants.ds:2:15
  0005 STORE_VAR      retries, r2    # tests/v0_6/fixtures/imports_basic/constants.ds:2:1
  0006 LOAD_CONST     r3, const 3    # tests/v0_6/fixtures/imports_basic/constants.ds:3:15
  0007 STORE_VAR      enabled, r3    # tests/v0_6/fixtures/imports_basic/constants.ds:3:1
  0008 RUN_CMD        ["echo", "\"Deploying {app} to {target}\""]    # tests/v0_6/fixtures/imports_basic/main.ds:3:1
  0009 RUN_CMD        ["echo", "$retries"]    # tests/v0_6/fixtures/imports_basic/main.ds:4:1
  0010 LOAD_VAR       r4, enabled    # tests/v0_6/fixtures/imports_basic/main.ds:5:4
  0011 JUMP_IF_FALSE  r4, 15    # tests/v0_6/fixtures/imports_basic/main.ds:5:4
  0012 PUSH_SCOPE        # tests/v0_6/fixtures/imports_basic/main.ds:5:12
  0013 RUN_CMD        ["echo", "\"enabled\""]    # tests/v0_6/fixtures/imports_basic/main.ds:6:3
  0014 POP_SCOPE         # tests/v0_6/fixtures/imports_basic/main.ds:5:12
  0015 RETURN         0    # tests/v0_6/fixtures/imports_basic/main.ds:1:1
