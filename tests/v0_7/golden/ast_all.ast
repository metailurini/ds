Script
  LetStmt result
    RunExpr
      Stage 0
        Word printf
        Word "hello"
  CmdStmt
    Stage 0
      Word echo
      Word result.stdout
  IfStmt
    Condition
      FieldExpr stdout
        IdentExpr result
    Then
      BlockStmt
        CmdStmt
          Stage 0
            Word echo
            Word "has stdout"
  IfStmt
    Condition
      FieldExpr ok
        IdentExpr result
    Then
      BlockStmt
        CmdStmt
          Stage 0
            Word echo
            Word "ok"
  CmdStmt
    Stage 0
      Word printf
      Word "hello"
    Redirect |> "out.txt"
  CmdStmt
    Stage 0
      Word sh
      Word -c
      Word "printf err >&2"
    Redirect !>> "err.txt"
  CmdStmt
    Stage 0
      Word sh
      Word -c
      Word "printf all; printf err >&2"
    Redirect &> "all.txt"
